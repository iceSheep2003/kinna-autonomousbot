LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
API_TOKEN=replace-with-at-least-24-random-characters
DATABASE_PATH=data/agent.sqlite
HOST=127.0.0.1
PORT=3100
# 启用联网搜索时同时配置以下两项：
# BRAVE_API_KEY=
# AGENT_CONFIG=agent.config.example.json

# QQ/NapCat: 先复制 agent.qq.example.json 并填写自己的账号/群白名单。
# AGENT_CONFIG=agent.qq.example.json
QQ_ONEBOT_TOKEN=
# 可选图片理解、语音转写（启用后再把 qq.inspect_media 加入 allowedTools）
QQ_MEDIA_BASE_URL=
QQ_MEDIA_API_KEY=
QQ_VISION_MODEL=
QQ_AUDIO_MODEL=
# 可选语音发送：openai / qwen / cosyvoice / qwen-audio
# 同时把 qq.speak 加入 allowedTools
QQ_TTS_PROVIDER=
QQ_TTS_BASE_URL=
QQ_TTS_API_KEY=
QQ_TTS_MODEL=
QQ_TTS_VOICE=
# 兼容旧 bot 的 catalog.json；启用后允许 qq.send_meme
QQ_MEMES_PATH=
# 可选 QQ 官方频道：配置 qq.channel 后再启用对应工具
QQ_CHANNEL_APP_ID=
QQ_CHANNEL_APP_SECRET=

# B 站：登录态只从环境读，绝不写进配置文件或让模型看到。
# SESSDATA 与 bili_jct 都来自浏览器登录后的 cookie；缺一个就当未登录（只能读，不能写）。
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
# 自己的 mid：配置后会轮询自己视频下的新评论，送进对应视频的场景会话。
BILIBILI_MID=
# 读视频：无头浏览器直接渲染 playurl 给的 DASH 流并截图，不需要 ffmpeg。
# 本机：npm i -D playwright && npx playwright install chromium（或指定已装好的浏览器）
BILIBILI_CHROME_PATH=
# 截图目录；不配 bilibili.publicBaseUrl 时截图以内联 data URL 进请求（本地免隧道），
# 配了则写成文件并给 URL，让 DeepSeek 自己下载（省请求体带宽，需要公网可达）。
BILIBILI_SHOT_DIR=data/public/shots
# 启用：AGENT_CONFIG=agent.bilibili.example.json
# 批准一条草稿（只有持 API_TOKEN 的人能调）：
#   GET  /v1/bilibili/drafts
#   POST /v1/bilibili/drafts/:id/approve
#   POST /v1/bilibili/drafts/:id/reject   {"note":"..."}
